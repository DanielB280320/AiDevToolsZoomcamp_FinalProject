# FitWise Docker Compose settings. `make up` copies this file to `.env` if `.env` is missing.
# `.env` is git-ignored: never commit real values. Every variable used by compose.yaml is listed
# here; all have safe local defaults. Deployed hosts use their own root-only env file (#12, #13).

# --- Compose project and images -------------------------------------------------------------
# Project name: prefixes containers, networks and the database volume (<name>_db-data).
COMPOSE_PROJECT_NAME=fitwise
# Images are <IMAGE_PREFIX>-backend:<TAG> and <IMAGE_PREFIX>-frontend:<TAG>.
# CD sets IMAGE_PREFIX=ghcr.io/<owner>/fitwise and TAG=<git sha> (#13).
IMAGE_PREFIX=fitwise
TAG=local

# --- Published port -------------------------------------------------------------------------
# The app (SPA + /api proxy) is served at http://localhost:${HTTP_PORT}.
HTTP_PORT=8088
# Interface to publish on. 127.0.0.1 keeps the local stack private; use 0.0.0.0 to reach it
# from other devices on your network (e.g. a phone).
HTTP_BIND=127.0.0.1

# --- PostgreSQL (service `db`) ----------------------------------------------------------------
# Used to initialise the database volume on first start and to build the backend DATABASE_URL.
# Use URL-safe characters in the password. Changing it later requires `make clean` (the volume
# keeps the password it was created with).
POSTGRES_DB=fitwise
POSTGRES_USER=fitwise
POSTGRES_PASSWORD=change-me-local-only

# --- Backend (see backend/.env.example for the meaning of each setting) ---------------------
# local | test | dev | prod
APP_ENV=local
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Connect timeout for new DB connections (1-60 s); bounds /readyz latency.
DATABASE_CONNECT_TIMEOUT_SECONDS=3
# HMAC key that signs session JWTs (#8), at least 32 characters. The value below is a
# DEV-ONLY PLACEHOLDER for the local stack: never use it on a deployed host. Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Migrations do not need it.
JWT_SECRET=dev-only-insecure-placeholder-change-me-0123456789
# Adds the Secure attribute to the session cookie. Keep false while the app is served over
# plain HTTP (ADR 0003); set true once HTTPS exists (spec §6.4).
SESSION_COOKIE_SECURE=false

# --- Telemetry (#16) --------------------------------------------------------------------------
# HMAC-SHA256 key that turns user ids into the `user_hash` seen in logs and traces (>= 16 chars;
# required in dev and prod). DEV-ONLY PLACEHOLDER: deployed hosts get a random value from their
# root-only env file. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
USER_HASH_SALT=dev-only-insecure-user-hash-salt
# Optional. Release reported as service.version and in log lines; defaults to TAG.
# APP_VERSION=
# Optional. OTLP/HTTP base URL of the OpenTelemetry Collector. Leave unset (default): nothing is
# exported and no network call is made. Set it once the observability stack exists (#17), e.g.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Tests (`make test`) --------------------------------------------------------------------
# Host port of the throwaway test PostgreSQL (service `db-test`, profile "test", 127.0.0.1 only).
# Ignored when TEST_DATABASE_URL is already set in the shell (e.g. a CI service container).
TEST_DB_PORT=15432
