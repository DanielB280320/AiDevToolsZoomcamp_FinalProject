[Unit]
Description=FitWise weekly adaptive calorie check (issue #42, F14)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/fitwise/bin/adaptive-calories.sh
TimeoutStartSec=15min
Nice=10
# A non-zero exit marks the unit failed: `systemctl --failed`, `journalctl -u fitwise-adaptive-calories`.
