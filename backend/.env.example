# FitWise backend settings. Copy to backend/.env for local runs (never commit .env).
# Every value is read from the environment by app/config.py (pydantic-settings).

# Required. SQLAlchemy/libpq URL of the PostgreSQL 16 database. A plain postgresql:// URL is
# accepted and switched to the psycopg 3 driver. Real credentials come from the environment or
# GitHub/EC2 secrets, never from git.
DATABASE_URL=postgresql+psycopg://fitwise:change-me@localhost:5432/fitwise

# Optional, default 3. Seconds to wait when opening a DB connection (bounds /readyz latency).
DATABASE_CONNECT_TIMEOUT_SECONDS=3

# Optional, default local. Environment name: local | test | dev | prod.
# In prod, Swagger UI (/api/v1/docs) and /api/v1/openapi.json are not served.
APP_ENV=local

# Optional, default INFO. Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# Optional, default dev. Release version, set to the image's git SHA by the deploy; exported as the
# OpenTelemetry resource attribute service.version and in every log line.
APP_VERSION=dev

# Optional. OTLP/HTTP (protobuf) base URL of the OpenTelemetry Collector; /v1/traces and
# /v1/metrics are appended. Leave unset (tests, `make up` without the observability stack) and
# nothing is exported and no network call is made; logs always go to stdout as JSON.
# The standard OTEL_* SDK variables also apply, e.g. OTEL_TRACES_SAMPLER and
# OTEL_METRIC_EXPORT_INTERVAL (milliseconds, default 60000).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Required in dev and prod (>= 16 random characters), optional elsewhere. HMAC-SHA256 key used to
# turn user ids into the `user_hash` seen in logs and traces; local/test fall back to a fixed
# development key. A secret: keep it in the GitHub environment / root-only env file on the host.
# Changing it changes every user_hash (dashboards lose continuity, nothing else breaks).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# USER_HASH_SALT=
# Required, at least 32 characters. HMAC key that signs the session JWTs in the
# fitwise_session cookie. Generate one per environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Migrations (alembic) do not need it.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# Optional, default false. Adds the Secure attribute to the session cookie. Keep false while the
# app is served over plain HTTP (ADR 0003); set true once HTTPS exists (spec §6.4).
SESSION_COOKIE_SECURE=false

# Tests only. Admin URL of a throwaway PostgreSQL server used by tests/integration/: each test
# run creates and drops its own databases there, so the user needs CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://fitwise:change-me@localhost:5432/postgres

# Optional. Open Food Facts base URL (F6 search). Integration tests point this at a local fake.
# OFF_BASE_URL=https://world.openfoodfacts.org
# Optional. Contact placed in the User-Agent `FitWise/<version> (<contact>)` sent to Open Food Facts.
# OFF_CONTACT=https://github.com/DanielB280320/AiDevToolsZoomcamp_FinalProject
# Optional, default 3. Seconds before an Open Food Facts request is abandoned (search degrades).
# OFF_TIMEOUT_SECONDS=3
